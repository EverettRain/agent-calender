# ===== Required =====

# 单用户鉴权 token，所有 API 都要 Authorization: Bearer <API_TOKEN>
API_TOKEN=change-me-to-a-long-random-string

# DeepSeek API
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxx

# ===== Optional (有合理默认值) =====

# 模型与端点（DeepSeek 兼容 OpenAI 协议）
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 数据库（仅 SQLite；不要换成 Postgres，资源预算不允许）
DATABASE_URL=sqlite+aiosqlite:///./data/data.db

# 时区（用于相对时间解析与展示）
TZ=Asia/Shanghai

# LLM 抽取管线
EXTRACTION_MAX_ATTEMPTS=3
EXTRACTION_VERIFY_ENABLED=true
EXTRACTION_VERIFY_MODEL=deepseek-v4-flash
EXTRACTION_TOKEN_BUDGET_PER_INGEST=8000

# 提前提醒默认值（CSV，LLM 没给时兜底；每个值 = 提前 N 分钟触发一次）
DEFAULT_EVENT_OFFSETS_MINUTES=0
DEFAULT_DEADLINE_OFFSETS_MINUTES=1440,60

# CORS 允许的 Origin（CSV，或 * 表示全部）
# 默认 * 因为我们用 Bearer Token 鉴权（无 cookie 无 CSRF 面）
# 想锁紧时改成：http://localhost:5173,file://
CORS_ALLOW_ORIGINS=*

# ===== Telegram Bot（可选，留空即关闭） =====
# 公网根 URL，用于 set_webhook
PUBLIC_BASE_URL=https://vps.everettrain.cn

# 从 @BotFather 拿到的 bot token
TELEGRAM_BOT_TOKEN=

# 白名单 chat_id（CSV）。给 bot 发 /start 它会回你自己的 chat_id
TELEGRAM_ALLOWED_CHAT_IDS=

# 随机串，TG 推 webhook 时会在 header 带上，服务端比对（用 openssl rand -hex 32 生成）
TELEGRAM_WEBHOOK_SECRET=

# 服务端口（systemd / dev 都用这个）
HOST=127.0.0.1
PORT=8080

# 日志级别 DEBUG/INFO/WARNING/ERROR
LOG_LEVEL=INFO
